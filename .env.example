# Copy to `.env` and adjust as needed:
#   cp .env.example .env
# Never commit `.env`.

# Django
DJANGO_SETTINGS_MODULE=fxpay.settings
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=fxpay
POSTGRES_USER=fxpay
POSTGRES_PASSWORD=replace-me-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Redis (use redis hostname `redis` under Docker Compose)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Deposit webhook HMAC shared secret (used in Phase 3)
DEPOSIT_WEBHOOK_SECRET=replace-me-webhook-secret
